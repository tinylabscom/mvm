{
  "schema_version": "0.1",
  "id": "hello",
  "apps": [
    {
      "name": "hello",
      "source": { "kind": "local_path", "path": "." },
      "image": { "kind": "nix_packages", "packages": ["python312"] },
      "resources": { "cpu_cores": 1, "memory_mb": 256, "rootfs_size_mb": 512 },
      "entrypoints": [
        {
          "kind": "command",
          "command": ["python", "main.py"],
          "env": { "PORT": { "kind": "literal", "value": "8080" } }
        }
      ],
      "env": {
        "PORT": { "kind": "literal", "value": "80" },
        "LOG": { "kind": "literal", "value": "info" }
      }
    }
  ]
}
