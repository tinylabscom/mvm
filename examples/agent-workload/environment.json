{
  "descriptor_version": 1,
  "pack": { "name": "agent/claude", "version": "2.0.1" },
  "target": "aarch64-linux",
  "entrypoint": { "argv": ["/etc/mvm/entrypoint"] },
  "resources": { "cpu_cores": 2, "memory_mb": 4096 },
  "secret_slots": [{ "name": "ANTHROPIC_API_KEY", "required": true }],
  "capabilities": ["egress"],
  "policy": {
    "allow_hosts": ["api.anthropic.com:443"],
    "request_budget": {
      "max_requests": 1,
      "max_spend_microusd": 500000,
      "model": "claude-haiku-4-5-20251001"
    }
  }
}
