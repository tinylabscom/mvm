      sha256 "@@SHA_X86_64_LINUX@@"
    end
  end

  def install
    hostbins = %w[
      mvmctl
      mvm-host-agent
      mvm-signer-helper
      mvm-network-endpoint
      mvm-broker
      mvm-audit-signer
      mvm-gpu-endpoint
    ]
    hostbins << "mvm-hvf-supervisor" if OS.mac?
    hostlib = OS.mac? ? "libmvm_hostlib.dylib" : "libmvm_hostlib.so"
    destination = lib/"mvmctl"
    destination.install(*hostbins, hostlib)
    hostbins.each { |name| bin.install_symlink destination/name }
    lib.install_symlink destination/hostlib
    (share/"mvmctl").mkpath
    (share/"mvmctl/package-managed").write "homebrew\n"

    # Release signatures and notarization must survive installation unchanged.
