# Transparent-egress kernel extras — merge ON TOP of ../kvm-x86-boot/microvm-x86_64.fragment.
#
# Adds the guest IP stack + netfilter REDIRECT so an unmodified connect() can be
# intercepted and funneled to vsock. Still NIC-less: there is no external/bridged
# interface and no userspace network gateway — only a dummy iface carrying a default
# route + a local REDIRECT into the transparent proxy. ADR-100's "no IP stack beyond
# loopback" is refined here: full transparency needs the stack present, with no
# egress path except vsock.
#
#   make tinyconfig
#   ./scripts/kconfig/merge_config.sh -m .config \
#       ../kvm-x86-boot/microvm-x86_64.fragment transparent-extras.fragment
#   make olddefconfig && make -j"$(nproc)" bzImage

# IP stack (vsock alone can't be intercepted transparently; connect() needs to route).
CONFIG_INET=y

# A dummy interface to carry a default route (no real NIC).
CONFIG_NETDEVICES=y
CONFIG_DUMMY=y

# netfilter + nat REDIRECT (the interception), and conntrack (SO_ORIGINAL_DST reads
# the conntrack original tuple).
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y

# iptables locks /run/xtables.lock — needs file locking (tinyconfig drops it).
CONFIG_FILE_LOCKING=y
