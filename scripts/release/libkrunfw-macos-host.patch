--- /dev/null
+++ b/patches/0099-macos-file2alias-uuid.patch
@@ -0,0 +1,30 @@
+From: TinyLabs MVM release build
+Subject: scripts/mod: isolate the kernel UUID type on macOS
+
+Apple's SDK exposes uuid_t as an unsigned-byte array through sys/types.h,
+while file2alias needs the kernel's struct-shaped UUID to inspect the b field.
+Alias the type only while the kernel device-table header is parsed by the
+macOS host tool. Other hosts retain the upstream source exactly.
+
+--- a/scripts/mod/file2alias.c
++++ b/scripts/mod/file2alias.c
+@@ -44,3 +44,10 @@
+-typedef struct {
+-	__u8 b[16];
+-} uuid_t;
++#ifdef __APPLE__
++typedef struct {
++	__u8 b[16];
++} kernel_uuid_t;
++#define uuid_t kernel_uuid_t
++#else
++typedef struct {
++	__u8 b[16];
++} uuid_t;
++#endif
+@@ -54 +61,4 @@
+-#include "../../include/linux/mod_devicetable.h"
++#include "../../include/linux/mod_devicetable.h"
++#ifdef __APPLE__
++#undef uuid_t
++#endif
