---
// Override Starlight's Sidebar: render the stock sidebar tree unchanged
// (collapsible groups, scroll-position persistence, mobile menu footer all
// stay Starlight's own), then append a quiet repo-link footer under it.
//
// No star count: Starlight doesn't expose GitHub API data, and this repo
// is private, so a build-time fetch has nowhere reliable to read a real
// count from. Showing a number here would mean hardcoding it — explicitly
// disallowed — so this is a plain link with no number.
import Default from "@astrojs/starlight/components/Sidebar.astro";
import config from "virtual:starlight/user-config";

const social = config.social ?? [];
const github = social.find((entry) => entry.icon === "github");
---

<Default />
<script is:inline>
  // Give each top-level sidebar group an emoji, bound to the group's
  // rendered *label text* rather than its position in astro.config.mjs's
  // `sidebar` array — see custom.css's "Sidebar group icons" comment for
  // why a position-keyed (`:nth-child`) binding was rejected. Runs
  // synchronously right after Default renders the sidebar markup, so the
  // icon is present before first paint (no flash of iconless headings).
  // Update this map when a group label changes or a group is added; a
  // label with no entry here simply renders without an icon rather than
  // erroring.
  (function () {
    var GROUP_ICONS = {
      "Getting Started": "🚀",
      "Install": "📦",
      "Working in the MicroVM": "🖥️",
      "Tutorials": "🎓",
      "Console": "⌨️",
      "Templates": "🧩",
      "Guides": "🧭",
      "Examples": "💡",
      "Security": "🔒",
      "Architecture": "🏛️",
      "Resources": "📚",
      "SDK": "🧰",
      "Reference": "📖",
      "Contributing": "🤝",
    };
    document
      .querySelectorAll('nav[aria-label="Main"] ul.top-level > li > details > summary > .group-label > .large')
      .forEach(function (labelEl) {
        var emoji = GROUP_ICONS[labelEl.textContent.trim()];
        if (!emoji) return;
        var icon = document.createElement("span");
        icon.className = "sidebar-group-icon";
        icon.setAttribute("aria-hidden", "true");
        icon.textContent = emoji;
        labelEl.before(icon);
      });
  })();
</script>
{
  github && (
    <div class="sidebar-footer">
      <a href={github.href} target="_blank" rel="noopener noreferrer" class="sidebar-repo-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z" />
        </svg>
        <span>{github.label}</span>
      </a>
    </div>
  )
}

<style>
  .sidebar-footer {
    margin-block-start: 0.5rem;
    padding-block-start: 1rem;
    border-top: 1px solid var(--color-edge);
  }

  .sidebar-repo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-muted);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .sidebar-repo-link:hover {
    color: var(--color-heading);
  }

  .sidebar-repo-link svg {
    flex-shrink: 0;
  }
</style>
