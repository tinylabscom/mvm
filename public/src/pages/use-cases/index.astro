---
import { getCollection } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";

const cases = (await getCollection("useCases")).sort((a, b) => a.data.order - b.data.order);
const teams = [...new Set(cases.map(entry => entry.data.team))];
---

<BlogLayout title="Use cases" description="Practical ways teams use mvm to isolate AI tools, run user code, and build repeatable environments.">
  <section class="blog-index">
    <div class="blog-index-hero">
      <div>
        <p class="blog-eyebrow">mvm use cases</p>
        <h1>Give every task its own boundary.</h1>
      </div>
      <p class="blog-lede">From an agent’s first tool call to a team’s CI pipeline: explore concrete workflows for running code without handing it your host.</p>
    </div>
    <div class="case-toolbar">
      <label for="team-filter">Explore by team</label>
      <select id="team-filter">
        <option value="">All teams</option>
        {teams.map(team => <option value={team}>{team}</option>)}
      </select>
      <p id="case-count" role="status" aria-live="polite">{cases.length} use cases</p>
    </div>
    <div class="case-grid">
      {cases.map(entry => (
        <article data-team={entry.data.team}>
          <a href={`/use-cases/${entry.id}/`}>
            <p class="blog-eyebrow">{entry.data.team}</p>
            <h2>{entry.data.title}</h2>
            <p>{entry.data.description}</p>
            <p class="case-outcome">{entry.data.outcome}</p>
            <span class="blog-read-more">Explore use case →</span>
          </a>
        </article>
      ))}
    </div>
    <aside class="case-cta">
      <h2>Start with one workload.</h2>
      <p>Choose the code you want to isolate, define what it needs, and follow the quickstart. Check platform support and security guarantees before choosing a deployment tier.</p>
      <a href="/getting-started/quickstart/">Get started with mvm →</a>
      <a href="/reference/platform-support/">Platform support</a>
      <a href="/security/claim-ledger/">Security guarantees</a>
    </aside>
  </section>
</BlogLayout>

<script>
  const filter = document.querySelector<HTMLSelectElement>("#team-filter");
  const cards = document.querySelectorAll<HTMLElement>("[data-team]");
  const count = document.querySelector("#case-count");
  filter?.addEventListener("change", () => {
    let visible = 0;
    cards.forEach(card => {
      card.hidden = !!filter.value && card.dataset.team !== filter.value;
      if (!card.hidden) visible++;
    });
    if (count) count.textContent = `${visible} use ${visible === 1 ? "case" : "cases"}`;
  });
</script>

<style>
  .case-toolbar { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-block: 2rem; }
  select { padding: .65rem 1rem; border: 1px solid var(--sl-color-hairline); border-radius: .5rem; background: var(--sl-color-bg); color: var(--sl-color-text); font: inherit; }
  #case-count { color: var(--sl-color-gray-2); }
  .case-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  article { border: 1px solid var(--sl-color-hairline); border-radius: 1rem; }
  article:hover { border-color: var(--sl-color-accent); }
  article a { display: flex; flex-direction: column; height: 100%; padding: 2rem; color: inherit; text-decoration: none; }
  h2 { font-size: 1.5rem; line-height: 1.3; }
  article p { line-height: 1.7; }
  .case-outcome { margin-top: auto; padding-top: 1rem; font-weight: 600; }
  .case-cta { margin-top: 4rem; padding-block: 2rem; border-top: 1px solid var(--sl-color-hairline); }
  .case-cta p { max-width: 70ch; line-height: 1.7; }
  .case-cta a { display: inline-block; margin: 1rem 1.5rem 0 0; }
  a:focus-visible, select:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 4px; }
  @media (max-width: 640px) { .case-grid { grid-template-columns: 1fr; } article a { padding: 1.5rem; } }
</style>
