---
import { getCollection } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const tagAliases: Record<string, string> = { microvms: "microvm", cve: "cve-teardown" };
const topicTag = (tag: string) => tagAliases[tag.toLowerCase()] ?? tag.toLowerCase();
const topics = [
  { tag: "microvm", label: "MicroVMs" },
  { tag: "agent-containment", label: "Agent containment" },
  { tag: "cve-teardown", label: "CVE breakdowns" },
  { tag: "supply-chain", label: "Supply chain" },
  { tag: "static-analysis", label: "Static analysis" },
].filter(({ tag }) => posts.some((post) => post.data.tags.some((item) => topicTag(item) === tag)));
---

<BlogLayout
  title="Blog"
  description="High-level notes on mvm architecture, microVM security, Nix, and secure sandboxing."
>
  <section class="blog-index">
    <header class="blog-index-hero">
      <h1>Blog</h1>
      <p class="blog-lede">Notes on microVMs, security, and running untrusted code.</p>
    </header>

    {topics.length > 0 && (
      <nav class="blog-topics" aria-label="Filter posts by topic" hidden>
        <span>Explore topics</span>
        <button type="button" data-topic="" aria-pressed="true">All posts</button>
        {topics.map(({ tag, label }) => (
          <button type="button" data-topic={tag} aria-pressed="false">{label}</button>
        ))}
      </nav>
    )}

    <div class="blog-list">
      {
        posts.length > 0 ? (
          posts.map((post) => (
            <article class="blog-list-item" data-topics={post.data.tags.map(topicTag).join(" ")}>
              <a href={`/blog/${post.id}/`}>
                <div class="blog-list-meta">
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                      timeZone: "UTC",
                    })}
                  </time>
                  <span aria-hidden="true">·</span>
                  <span>{(post.data.tags.find((tag) => tag.toLowerCase() !== "security") ?? post.data.tags[0])?.replaceAll("-", " ")}</span>
                </div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <span class="blog-read-more">Read post <span aria-hidden="true">→</span></span>
              </a>
            </article>
          ))
        ) : (
          <p class="blog-empty">No posts yet. Check back soon.</p>
        )
      }
    </div>
  </section>
</BlogLayout>

<script>
  const topics = document.querySelector<HTMLElement>(".blog-topics");
  if (topics) {
    const buttons = [...topics.querySelectorAll<HTMLButtonElement>("button[data-topic]")];
    const posts = [...document.querySelectorAll<HTMLElement>(".blog-list-item")];
    const available = new Set(buttons.map((button) => button.dataset.topic));
    const selected = new URLSearchParams(location.search).get("topic") ?? "";

    function showTopic(topic: string) {
      for (const button of buttons) {
        button.setAttribute("aria-pressed", String(button.dataset.topic === topic));
      }
      for (const post of posts) {
        post.hidden = !!topic && !post.dataset.topics?.split(" ").includes(topic);
      }
    }

    topics.hidden = false;
    showTopic(available.has(selected) ? selected : "");
    topics.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("button[data-topic]");
      if (!button) return;
      const topic = button.dataset.topic ?? "";
      showTopic(topic);
      const url = new URL(location.href);
      if (topic) url.searchParams.set("topic", topic);
      else url.searchParams.delete("topic");
      history.replaceState(null, "", url);
    });
  }
</script>
