---
// The architecture overview. Rendered through the Starlight shell (see
// src/pages/architecture.astro) rather than as the standalone HTML file it
// used to be, so it shares the site's header, theme toggle, footer and
// token system instead of carrying private copies of all four.
//
// It renders through the Hero slot for the same reason the landing page
// does: that slot sits outside `.sl-markdown-content`, whose sibling-margin
// and heading rules would otherwise fight this page's own layout.
import { Footer } from "../landing/Footer";
