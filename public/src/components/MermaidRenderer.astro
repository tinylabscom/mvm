<script>
  const currentTheme = () => {
    const explicitTheme = document.documentElement.dataset.theme;
    if (explicitTheme === "light") return "default";
    if (explicitTheme === "dark") return "dark";
    return window.matchMedia("(prefers-color-scheme: light)").matches ? "default" : "dark";
  };

  const renderMermaidBlocks = async () => {
    const mermaidBlocks = Array.from(
      document.querySelectorAll("pre > code.language-mermaid, pre[data-language='mermaid']"),
    );
    if (mermaidBlocks.length === 0) return;

    const { default: mermaid } = await import("mermaid");

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: "strict",
      theme: currentTheme(),
    });

    const diagramSource = (block) => {
      const pre = block.matches("pre") ? block : block.closest("pre");
      const copyButton = pre?.parentElement?.querySelector("button[data-code]");
      const source = copyButton?.getAttribute("data-code") ?? block.textContent ?? "";

      return source.replace(/\u007f/g, "\n");
    };

    const diagrams = mermaidBlocks.map((block, index) => {
      const diagram = document.createElement("div");
      diagram.className = "mermaid";
      diagram.id = `mermaid-${index}`;
      diagram.textContent = diagramSource(block);

      const pre = block.matches("pre") ? block : block.closest("pre");
      const container = pre?.closest(".expressive-code") ?? pre ?? block;
      container.replaceWith(diagram);

      return diagram;
    });

    await mermaid.run({ nodes: diagrams });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", renderMermaidBlocks, { once: true });
  } else {
    renderMermaidBlocks();
  }
</script>
