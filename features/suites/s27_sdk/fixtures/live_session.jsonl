["machine.run", {"image": "docker.io/library/python:3.12-slim", "mode": "transient", "name": "<vm-name>", "profile": "dev", "ttl_seconds": 1800}]
["guest.proc.start", {"argv": ["python", "-c", "print('ok')"], "id": "sdk-bdd-vm"}]
["guest.proc.stream.open", {"id": "sdk-bdd-vm", "token": "ptok-bdd"}]
["guest.proc.stream.next", {"stream": 1}]
["guest.fs.write", {"create_parents": false, "data_b64": "aGVsbG8=", "follow_symlinks": false, "id": "sdk-bdd-vm", "mode": 420, "path": "/app/hello.txt"}]
["guest.fs.read", {"id": "sdk-bdd-vm", "length": 16777216, "offset": 0, "path": "/app/hello.txt"}]
["guest.fs.list", {"id": "sdk-bdd-vm", "path": "/app"}]
["machine.stop", {"id": "sdk-bdd-vm"}]
