["machine.run", {"command": ["/serve", "--port", "9222"], "env": {"MODE": "headless"}, "mode": "persistent", "name": "<vm-name>", "profile": "dev", "template": "chromium", "ttl_seconds": 1800}]
["guest.proc.stream.open", {"id": "sdk-bdd-vm", "token": "boot-tok"}]
["guest.proc.stream.next", {"stream": 1}]
["machine.stop", {"id": "sdk-bdd-vm"}]
["machine.rm", {"id": "sdk-bdd-vm"}]
["machine.run", {"command": ["uname"], "env": {"LANG": "C"}, "image": "docker.io/library/alpine:3.20", "mode": "persistent", "name": "<vm-name>"}]
["guest.proc.stream.open", {"id": "sdk-bdd-vm", "token": "boot-tok"}]
["guest.proc.stream.next", {"stream": 1}]
["machine.stop", {"id": "sdk-bdd-vm"}]
["machine.rm", {"id": "sdk-bdd-vm"}]
["machine.logs.stream.open", {"follow": true, "id": "sdk-bdd-vm", "streams": ["stdout", "stderr"], "tail_lines": 10}]
["machine.logs.stream.next", {"stream": 2, "wait_ms": 5000}]
