  "proposed_manifest_operations": [
    "fold mvm-backends into mvm-vmm",
    "fold mvm-net and mvm-bundler into mvm-core",
    "retire runmvm-client",
    "assign hostd source to audit/egress/admission/broker/supervisor",
    "remove mvm-agentd, mvm-http and mvm-fs from VMM/backend normal dependencies only after their source cuts"
  ],
  "future_call_site_rewrites": {
    "PREPARED-HELPER-PATH": "Move source-build consent/freshness/compilation above VMM; drivers and endpoint spawners receive prepared verified helper paths. Never treat consent as UI reporting.",
    "FC-STOP-WRAPPER": "Runtime wrapper reaps endpoint before calling low FC stop, including not-running return.",
    "INJECT-LINUX-ENV": "Low shell adapters receive existing core LinuxEnv rather than importing runtime default selection.",
    "PREPARED-PLAN-BINDING": "HVF restore receives caller-prepared plan binding with identical absence/error handling.",
    "PREPARED-COLLECTOR": "Higher composition prepares daemon registration/telemetry inputs; preserve warning/error branches and private key handoff."
  },
  "limits": [
    "No source code was moved and no projected Cargo manifests were compiled.",
    "ADR interface review records source-based recommendations for native completion, caller registration and confinement diagnostics; proposed cross-crate APIs and call-site restrictions remain uncompiled and owner acceptance remains outstanding.",
    "Macro expansion, trait resolution, shadowing and generated code are not compiler-validated.",
    "Dev/test edges, detached fuzz/browser workspaces and actual guest feature closures are not certified by this production graph.",
    "Feature-union treats Cargo/CPU feature and debug predicates conservatively; it does not assert runtime support on Windows or Wasm.",
    "Other host consumers of agentd remain outside the VMM protocol extraction."
  ],
