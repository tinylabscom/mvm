        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "mvm.machine.inspect",
      "requires": "inspect"
    },
    {
      "description": "List machines visible through the selected client.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
