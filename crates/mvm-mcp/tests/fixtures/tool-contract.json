      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cpus": {
            "minimum": 1,
            "type": "integer"
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "image": {
            "type": "string"
          },
          "memory_mib": {
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "image"
        ],
        "type": "object"
      },
