            "type": "object"
          },
          "image": {
            "type": "string"
          },
          "memory_mib": {
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "image"
        ],
        "type": "object"
      },
      "name": "mvm.machine.create",
      "requires": "create"
    },
    {
