{
  "tools": [
    {
      "description": "Describe the selected backend and client operation surface.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "name": "mvm.backend_capabilities",
      "requires": null
    },
    {
      "description": "Read the next queued event from the driven program without waiting.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "name": "mvm.drive.events",
      "requires": "drive_grant"
    },
    {
      "description": "List a directory inside the granted workspace roots.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "follow_symlinks": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "name": "mvm.drive.files.list",
      "requires": "drive_grant"
    },
    {
      "description": "Read bounded bytes from a path inside the granted workspace roots.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "follow_symlinks": {
            "type": "boolean"
          },
          "length": {
            "minimum": 0,
            "type": "integer"
          },
          "offset": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "length"
        ],
        "type": "object"
      },
      "name": "mvm.drive.files.read",
      "requires": "drive_grant"
    },
    {
      "description": "Write bounded base64 bytes inside the granted workspace roots.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "create_parents": {
            "type": "boolean"
          },
          "data_b64": {
            "type": "string"
          },
          "follow_symlinks": {
            "type": "boolean"
          },
          "mode": {
            "maximum": 4095,
            "minimum": 0,
            "type": "integer"
          },
          "offset": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "truncate": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "data_b64"
        ],
        "type": "object"
      },
      "name": "mvm.drive.files.write",
      "requires": "drive_grant"
    },
    {
      "description": "Start the program selected by the signed drive grant.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cwd": {
            "type": "string"
          }
        },
        "required": [
          "cwd"
        ],
        "type": "object"
      },
      "name": "mvm.drive.open",
      "requires": "drive_grant"
    },
    {
      "description": "Write one ordered base64 input frame to the driven program.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "data_b64": {
            "type": "string"
          },
          "eof": {
            "type": "boolean"
          },
          "seq": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "seq",
          "data_b64"
        ],
        "type": "object"
      },
      "name": "mvm.drive.write",
      "requires": "drive_grant"
    },
    {
      "description": "Create a stopped machine through MvmClient.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cpus": {
            "minimum": 1,
            "type": "integer"
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "image": {
            "type": "string"
          },
          "memory_mib": {
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "image"
        ],
        "type": "object"
      },
      "name": "mvm.machine.create",
      "requires": "create"
    },
    {
      "description": "Run a non-interactive command when the selected client supports it.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "command"
        ],
        "type": "object"
      },
      "name": "mvm.machine.exec",
      "requires": "exec"
    },
    {
      "description": "Inspect one machine.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "mvm.machine.inspect",
      "requires": "inspect"
    },
    {
      "description": "List machines visible through the selected client.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "starting",
              "running",
              "stopped",
              "paused",
              "failed"
            ],
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "mvm.machine.list",
      "requires": "list"
    },
    {
      "description": "Read bounded machine logs.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "follow": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "tail_lines": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "mvm.machine.logs",
      "requires": "logs"
    },
    {
      "description": "Pause a running machine.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "primed_barrier": {
            "type": "boolean"
          },
          "primed_timeout_secs": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "mvm.machine.pause",
      "requires": "pause"
    },
    {
      "description": "Patch supported machine configuration fields.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "allow_host": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "cpus": {
            "minimum": 1,
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "memory_mib": {
            "minimum": 1,
            "type": "integer"
          },
          "net": {
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "mvm.machine.reconfigure",
      "requires": "reconfigure"
    },
    {
      "description": "Remove a machine idempotently.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "mvm.machine.remove",
      "requires": "remove"
    },
    {
      "description": "Resume a paused machine.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "warm": {
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "mvm.machine.resume",
      "requires": "resume"
    },
    {
      "description": "Create and start a machine through MvmClient.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cpus": {
            "minimum": 1,
            "type": "integer"
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "image": {
            "type": "string"
          },
          "memory_mib": {
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "image"
        ],
        "type": "object"
      },
      "name": "mvm.machine.run",
      "requires": "run"
    },
    {
      "description": "Set or clear a machine TTL.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "mvm.machine.set_ttl",
      "requires": "set_ttl"
    },
    {
      "description": "Start a created machine.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "mvm.machine.start",
      "requires": "start"
    },
    {
      "description": "Stop a machine idempotently.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "mvm.machine.stop",
      "requires": "stop"
    }
  ]
}
